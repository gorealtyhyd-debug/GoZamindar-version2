{
  "name": "gozamindar",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "predev": "node scripts/fetch-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-images.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "npx --yes serve dist",
    "images:refresh": "node scripts/fetch-images.mjs --force",
    "lint": "next lint",
    "indexnow": "node scripts/indexnow.mjs",
    "clean": "node -e \"['dist','out','.next'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "admin": "node scripts/admin-server.mjs"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
